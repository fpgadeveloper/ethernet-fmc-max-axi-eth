/*
 * SoC-side board fixups for vmk180 (Versal), layered on top of the
 * gen-machineconf / lopper-generated Linux device tree (which already carries
 * the PS config and the design's PL hardware from the XSA). Scoped to the Linux
 * domain by device-tree.bbappend. Ported from the Ethernet FMC Max AXI Ethernet PetaLinux BSP.
 */

/* Board RJ45s (GEM0 = u198 PHY, GEM1 = u134 PHY): the SDT flow does not
 * describe the board-level TI DP83867 PHYs, so Linux falls back to the
 * Generic PHY driver and the RGMII clock delays are never programmed -
 * the link negotiates 1G but passes no packets. Both PHYs sit on GEM0's
 * MDIO bus (GEM1 has no MDIO: xlnx,has-mdio=0, matching the board).
 * Values from the official versal-vmk180-revA.dts (VMK180 = VCK190 for
 * Ethernet); reset-gpios omitted because the SDT device tree does not define the
 * gpio1 label - the PHYs power up out of reset from straps.
 * No fixed MAC: the MAC stays random per boot (add a local-mac-address
 * property to pin one).
 * Ported from the 2x-qsfp28-fmc vck190 Yocto BSP (HW-verified on VCK190).
 */
&gem0 {
	phy-handle = <&gem0_phy>;
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		gem0_phy: ethernet-phy@1 {
			compatible = "ethernet-phy-id2000.a231";
			reg = <1>;
			ti,rx-internal-delay = <0xb>;
			ti,tx-internal-delay = <0xa>;
			ti,fifo-depth = <0x1>;
			ti,dp83867-rxctrl-strap-quirk;
		};
		gem1_phy: ethernet-phy@2 {
			compatible = "ethernet-phy-id2000.a231";
			reg = <2>;
			ti,rx-internal-delay = <0xb>;
			ti,tx-internal-delay = <0xa>;
			ti,fifo-depth = <0x1>;
			ti,dp83867-rxctrl-strap-quirk;
		};
	};
};
&gem1 {
	phy-handle = <&gem1_phy>;
};
